{
  "name": "orinonu",
  "version": "0.0.5",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/check-runtime.mjs && node src/server.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "test": "node --test tests/*.test.mjs tests/acceptance/*.test.mjs bundles/jev-decisions/*.test.mjs",
    "build:ui": "npm --prefix frontend run build",
    "check:ui": "npm --prefix frontend run check",
    "test:ui": "npm --prefix frontend test",
    "test:ui:browser": "npm --prefix frontend run test:browser",
    "check:agents": "npm --prefix bundles/orinonu-agents run check",
    "test:agents": "npm --prefix bundles/orinonu-agents test",
    "build:agents": "npm --prefix bundles/orinonu-agents run build",
    "ui": "node scripts/serve-ui.mjs",
    "update:prepare": "node scripts/prepare-update.mjs",
    "release:source": "node scripts/release-source.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
